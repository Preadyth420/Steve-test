[ai]
    # Choose which provider powers the agents
    # Options: groq (default), openai, gemini, local
    provider = "groq"

    # To override per-agent, copy this file as steve-<profile>.toml (e.g. steve-builder.toml)
    # and customize the sections below.

[openai]
    # Your OpenAI API key
    # Get your API key from: https://platform.openai.com/api-keys
    apiKey = "your-openai-api-key-here"

    # Using GPT-3.5-turbo (much cheaper than GPT-4 for testing)
    model = "gpt-3.5-turbo"
    
    # Maximum tokens per API request
    maxTokens = 1000

    # Temperature (0.0-2.0, lower is more deterministic)
    temperature = 0.7

[local]
    # Base URL for your local llama.cpp/LM Studio server (OpenAI compatible endpoint)
    serverUrl = "http://localhost:8080/v1/chat/completions"

    # Model identifier or file name, depends on the server you run
    model = "models/llama-3.1-8b-instruct.Q4_K_M.gguf"

    # Optional auth token (leave blank if not needed)
    apiKey = ""

    # Maximum tokens returned by the local model
    maxTokens = 512

    # Temperature for local responses
    temperature = 0.7

[behavior]
    # Ticks between action checks (20 ticks = 1 second)
    actionTickDelay = 20
    
    # Allow Steves to respond in chat
    enableChatResponses = true
    
    # Maximum number of Steves that can be active simultaneously
    maxActiveSteves = 10

